# Copy to .env for local development. Never commit the real .env.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
PAYSTACK_SECRET_KEY=sk_test_or_live_key_here
FRONTEND_URL=http://localhost:5500
NODE_ENV=development
PORT=3000
MAX_TRANSFER_AMOUNT=10000000
MAX_SINGLE_FUNDING=10000000
SIM_DAILY_FUNDING_CAP=1000000
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/flash_simulator_test